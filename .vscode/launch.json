{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start site + Discord bot",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "${workspaceFolder}/bot",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "API \\+ site on http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run index.html only (no bot / no API)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
